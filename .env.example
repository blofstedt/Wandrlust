# ---------------------------------------------------------------
# Wandrlust environment configuration
# Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------

PORT=3000

# --- AI campsite discovery (optional) ---------------------------
# Without this, /api/camping-ai returns an empty result set and the
# app falls back to the curated + OSM datasets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Weather (no key needed) ------------------------------------
# NWS api.weather.gov requires no key but asks for a contact string
# in the User-Agent header. Set this to your email or app URL.
NWS_USER_AGENT=wandrlust (your-email@example.com)

# --- Supabase (optional) ----------------------------------------
# Anon key is safe to expose: RLS restricts it to reads plus
# narrowly-scoped review/submission inserts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key BYPASSES RLS. Server/scripts only.
# Never expose it to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (optional) ----------------------------------------
# Generate with: npm run vapid
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
PUSH_DISPATCH_SECRET=

# --- Routing (all optional) -------------------------------------
# Routing is server-side now (/api/route) and works with NO keys.
# The ladder, best first:
#
#   1. OpenRouteService, if ORS_API_KEY is set. Routes over tracks
#      AND honours real rig height/width/length/weight.
#      Free tier: https://openrouteservice.org/dev/#/signup
#   2. Valhalla on the FOSSGIS public instance. No key. Routes over
#      forest tracks, which is the whole game for dispersed camping.
#      Set NWS_USER_AGENT above — FOSSGIS asks public users to
#      identify themselves. Point VALHALLA_URL at your own instance
#      if you'd rather not lean on theirs.
#   3. OSRM. Last resort. Cannot see an unpaved track at all, so
#      routes stop where the maintained road does.
ORS_API_KEY=
VALHALLA_URL=

# --- Cell coverage approximation (optional) ---------------------
# Server-side only. Without it, /api/cell-coverage answers "not
# configured" and the app says so rather than guessing — which is
# the intended behaviour, not a broken state.
#
# This is NOT a coverage map. OpenCellID is a crowd-sourced register
# of tower POSITIONS; the estimate is distance to the nearest one and
# it ignores terrain entirely. Free key: https://opencellid.org/
OPENCELLID_API_KEY=

# --- Crown land vector overlay (optional) -----------------------
# Bring your own Mapbox account and tileset. When either value is
# missing the overlay is skipped and the map still works.
VITE_MAPBOX_TOKEN=
VITE_CROWN_LAND_TILESET=
VITE_CROWN_LAND_LAYER=on_general_use_areas
